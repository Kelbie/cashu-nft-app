<?xml version="1.0" encoding="utf-8"?>
<!-- The code sits on white whatever the theme, so a camera always has its contrast. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp"><shape><solid android:color="@color/lime" /><corners android:radius="18dp" /></shape></item>
    <item android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/white" /><stroke android:width="2dp" android:color="@color/black" /><corners android:radius="18dp" /></shape></item>
</layer-list>

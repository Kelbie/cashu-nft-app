<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The look of nonfungible.cash: its two palettes, its three typefaces, pills, and a hard
         offset shadow under whatever can be pressed. -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">?attr/isLightTheme</item>
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceContainerLow">@color/paper</item>
        <item name="colorSurfaceContainerHigh">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorOutline">@color/ink</item>
        <item name="colorError">@color/bad</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <!-- Only the platform attribute: AppCompat's own would outrank every style's face. -->
        <item name="android:fontFamily">@font/inter_400</item>
        <item name="bottomSheetDialogTheme">@style/Theme.App.Sheet</item>
    </style>

    <style name="Theme.App.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.Sheet</item>
    </style>

    <style name="Widget.App.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/bg</item>
        <item name="shapeAppearance">@style/Shape.App.Sheet</item>
    </style>

    <style name="Shape.App.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Type. Headings are the display face, heavy and tight; hashes and small labels are mono. -->
    <style name="Text.App" parent="">
        <item name="android:fontFamily">@font/inter_400</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.App.Strong">
        <item name="android:fontFamily">@font/inter_700</item>
    </style>

    <style name="Text.App.Muted">
        <item name="android:fontFamily">@font/inter_600</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.App.Mono">
        <item name="android:fontFamily">@font/jetbrains_mono_400</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.App.Display">
        <item name="android:fontFamily">@font/bricolage_grotesque_800</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Text.App.Display.Title">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- What a sheet says under its title: what will happen, in a sentence or two. -->
    <style name="Text.App.Sheet" parent="Text.App.Muted">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- A button is a pill with a border, sitting on its shadow until it is pressed. -->
    <style name="Widget.App.Button" parent="">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:fontFamily">@font/inter_700</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.App.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <style name="Widget.App.Button.Ghost">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.App.IconButton" parent="">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@animator/press_small</item>
    </style>

    <style name="Widget.App.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:fontFamily">@font/inter_600</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:fontFamily">@font/inter_600</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/ink</item>
    </style>

    <!-- One more, one fewer. -->
    <style name="Widget.App.Step" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:fontFamily">@font/inter_700</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:stateListAnimator">@animator/press_small</item>
    </style>

    <style name="Widget.App.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:fontFamily">@font/inter_700</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- One of a few ways to do something, each with a picture of itself. The chosen one is lime. -->
    <style name="Widget.App.Choice" parent="">
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:fontFamily">@font/inter_700</item>
        <item name="android:textColor">@color/choice_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>

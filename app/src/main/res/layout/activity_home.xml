<?xml version="1.0" encoding="utf-8"?>

<!-- Where the app opens: whose account it is, the three things an account has, and at the foot
     what can be done with the one in view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The page that does an account's work with the site. It is in the window so that it runs, and out of sight. -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:importantForAccessibility="noHideDescendants" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Whose this is. Touching it shows every account on the phone. -->
            <LinearLayout
                android:id="@+id/account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:gravity="center_vertical"
                android:minHeight="50dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="4dp"
                android:stateListAnimator="@animator/press">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_thumb"
                    android:importantForAccessibility="no"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/name"
                    style="@style/Text.App.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxWidth="170dp"
                    android:maxLines="1"
                    android:textSize="16sp"
                    tools:text="Kelbie" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/settings"
                style="@style/Widget.App.IconButton"
                android:contentDescription="@string/door_settings"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <cash.nonfungible.app.Halftone
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <!-- What the account holds, tickets first. -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:id="@+id/tickets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- What the account made and the doors it keeps. -->
                        <LinearLayout
                            android:id="@+id/collections"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />

                        <!-- What the account can spend, and where. -->
                        <LinearLayout
                            android:id="@+id/wallet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/balance"
                                    style="@style/Text.App.Display"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:textSize="46sp"
                                    tools:text="12,400" />

                                <TextView
                                    android:id="@+id/unit"
                                    style="@style/Text.App.Display"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginBottom="6dp"
                                    android:textSize="20sp"
                                    tools:text="sats" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/at"
                                    style="@style/Text.App.Muted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    tools:text="at Minibits" />

                                <TextView
                                    android:id="@+id/worthless"
                                    style="@style/Widget.App.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_badge_test"
                                    android:text="@string/wallet_worthless"
                                    android:textColor="@color/black"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <!-- What is tied up or on its way, when anything is. -->
                            <TextView
                                android:id="@+id/tied"
                                style="@style/Text.App.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:visibility="gone"
                                tools:text="2,100 locked in an offer"
                                tools:visibility="visible" />

                            <LinearLayout
                                android:id="@+id/mints"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="vertical" />

                            <!-- What collections made here have been paid and still hold. -->
                            <LinearLayout
                                android:id="@+id/tills"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                            <LinearLayout
                                android:id="@+id/history"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </LinearLayout>

                        <!-- Nothing yet, and the ways to something. -->
                        <LinearLayout
                            android:id="@+id/empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_empty"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="40dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/empty_title"
                                style="@style/Text.App.Display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="24sp"
                                tools:text="@string/guest_none" />

                            <TextView
                                android:id="@+id/empty_help"
                                style="@style/Text.App.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                tools:text="@string/guest_none_help" />

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </cash.nonfungible.app.Halftone>

        <!-- Something to know that belongs to no sheet: what was just done, or why it was not. -->
        <TextView
            android:id="@+id/note"
            style="@style/Text.App.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Sold. The sats are in your wallet." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/second"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="@string/guest_find" />

            <TextView
                android:id="@+id/first"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                tools:text="@string/guest_scan" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>

<!-- Room for the system's bars is made by the frame, which gives up its own padding to do it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            style="@style/Widget.App.IconButton"
            android:contentDescription="@string/common_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            style="@style/Text.App.Display.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/settings_title" />

    </LinearLayout>

    <cash.nonfungible.app.Halftone
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">


                <!-- The account in use: what it is called, and the key to everything that is its. -->
                <TextView
                    style="@style/Text.App.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/settings_account"
                    android:textAllCaps="true" />

                <TextView
                    style="@style/Text.App.Strong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:labelFor="@+id/name"
                    android:text="@string/settings_name"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/name"
                    style="@style/Widget.App.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40" />

                <TextView
                    style="@style/Text.App.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/welcome_name_help" />

                <!-- The page that reads the account's key. -->
                <FrameLayout
                    android:id="@+id/pages"
                    android:layout_width="2dp"
                    android:layout_height="2dp"
                    android:importantForAccessibility="noHideDescendants" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/key"
                        layout="@layout/row_setting" />

                </LinearLayout>

                <!-- A door this phone keeps: what it is called and how it behaves. -->
                <TextView
                    style="@style/Text.App.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/settings_doors"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/door_label"
                    style="@style/Text.App.Strong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:labelFor="@+id/door"
                    android:text="@string/settings_door"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/door"
                    style="@style/Widget.App.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="40" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sound"
                    style="@style/Widget.App.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_sound" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/express"
                    style="@style/Widget.App.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_express" />

                <LinearLayout
                    android:id="@+id/relays_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.App.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/relays"
                        android:text="@string/settings_relays"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/relays"
                        style="@style/Widget.App.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/jetbrains_mono_400"
                        android:importantForAutofill="no"
                        android:inputType="textUri|textMultiLine"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Text.App.Strong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/site"
                        android:text="@string/settings_site"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/site"
                        style="@style/Widget.App.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/jetbrains_mono_400"
                        android:hint="https://nonfungible.cash"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- What cannot be undone, last and apart. -->
                <TextView
                    style="@style/Text.App.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/settings_delete"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/delete_account"
                        layout="@layout/row_setting" />

                    <include
                        android:id="@+id/delete_all"
                        layout="@layout/row_setting" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </cash.nonfungible.app.Halftone>

    <!-- Saving is always in reach, however far down the page has gone. -->
    <TextView
        android:id="@+id/save"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/settings_save" />

</LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>

<!-- One thing that will go: what it is, what becomes of it, and how far that has got. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/faint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <!-- Done, or not: shown once the deleting has begun. -->
        <ImageView
            android:id="@+id/mark"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/what"
                style="@style/Text.App.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Harbour Lights" />

            <TextView
                android:id="@+id/detail"
                style="@style/Text.App.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                tools:text="38 unsold NFTs burned · 12 with their holders stay theirs · name becomes [deleted]" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/thumbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/act"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="42dp"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Move out first" />

    </LinearLayout>

</LinearLayout>

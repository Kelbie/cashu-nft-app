<?xml version="1.0" encoding="utf-8"?>

<!-- Deleting an account, or everything: exactly what will go, then one button that must be held. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

    <!-- The pages that do the deleting with the site. In the window so that they run, and out of sight. -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:importantForAccessibility="noHideDescendants" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                style="@style/Widget.App.IconButton"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                style="@style/Text.App.Display.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Delete everything" />

        </LinearLayout>

        <cash.nonfungible.app.Halftone
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/intro"
                        style="@style/Text.App.Sheet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        tools:text="@string/delete_all_intro" />

                    <LinearLayout
                        android:id="@+id/cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                    <!-- What stays whatever is done: the site cannot remove it. -->
                    <TextView
                        android:id="@+id/stays"
                        style="@style/Text.App.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/delete_all_stays" />

                </LinearLayout>

            </ScrollView>

        </cash.nonfungible.app.Halftone>

        <!-- Money that would go with it is agreed to by itself, before the button can be held. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/abandon"
            style="@style/Widget.App.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/bad"
            android:visibility="gone"
            tools:text="Delete the 12,400 sats too"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/note"
            style="@style/Text.App.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:text="Deleting… 3 of 7 done. Keep the app open."
            tools:visibility="visible" />

        <cash.nonfungible.app.HoldButton
            android:id="@+id/hold"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/after"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/leave"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete_all_leave" />

            <TextView
                android:id="@+id/again"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/delete_all_again" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

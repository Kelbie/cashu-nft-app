<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        style="@style/Text.App.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/own_help" />

    <TextView
        android:id="@+id/brief"
        style="@style/Widget.App.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="44dp"
        android:text="@string/own_brief" />

    <EditText
        android:id="@+id/name"
        style="@style/Widget.App.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/own_name"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:maxLength="30" />

    <EditText
        android:id="@+id/scene"
        style="@style/Widget.App.Field"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/jetbrains_mono_400"
        android:gravity="top"
        android:hint="@string/own_scene"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:textSize="12sp" />

</LinearLayout>

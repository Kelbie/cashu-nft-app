<?xml version="1.0" encoding="utf-8"?>

<!-- One of the wallet's mints: what it is called, what is there, and whether it is the one in view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_row_chosen"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/name"
        style="@style/Text.App.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pill_text"
        android:textSize="16sp"
        tools:text="Minibits" />

    <TextView
        android:id="@+id/test"
        style="@style/Widget.App.Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/wallet_test"
        android:visibility="gone" />

    <TextView
        android:id="@+id/amount"
        style="@style/Text.App.Mono"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/pill_text"
        android:textSize="14sp"
        tools:text="12,400" />

    <ImageView
        android:id="@+id/chosen"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_circle" />

</LinearLayout>

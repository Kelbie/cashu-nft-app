<?xml version="1.0" encoding="utf-8"?>

<!-- Deleting a collection: what will happen, a button that must be held, and how far it has got. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_grabber" />

    <TextView
        android:id="@+id/title"
        style="@style/Text.App.Display.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Delete Second Run?" />

    <TextView
        android:id="@+id/text"
        style="@style/Text.App.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        tools:text="Every NFT this collection still holds is burned." />

    <!-- While it works: dots, then a tick. -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <cash.nonfungible.app.Dots
            android:id="@+id/dots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <cash.nonfungible.app.Tick
            android:id="@+id/tick"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tick"
            android:padding="10dp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/note"
        style="@style/Text.App.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Burning 3 of 8…"
        tools:visibility="visible" />

    <!-- Held until it fills: a tap does nothing, so nothing is deleted by a slip. -->
    <cash.nonfungible.app.HoldButton
        android:id="@+id/hold"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/close"
        style="@style/Widget.App.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/delete_keep" />

</LinearLayout>

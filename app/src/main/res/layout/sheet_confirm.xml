<?xml version="1.0" encoding="utf-8"?>

<!-- A question before something is done: what, what it means, and yes or no. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_grabber" />

    <TextView
        android:id="@+id/title"
        style="@style/Text.App.Display.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Clear admissions?" />

    <TextView
        android:id="@+id/text"
        style="@style/Text.App.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        tools:text="Every NFT can be admitted again." />

    <!-- What cannot be undone is held, and has the sheet's width to itself. -->
    <cash.nonfungible.app.HoldButton
        android:id="@+id/hold"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/no"
            style="@style/Widget.App.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@android:string/cancel" />

        <TextView
            android:id="@+id/yes"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            tools:text="Clear" />

    </LinearLayout>

</LinearLayout>

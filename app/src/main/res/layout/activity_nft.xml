<?xml version="1.0" encoding="utf-8"?>

<!-- One of a guest's NFTs, on a page coloured from its picture. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- The page that makes an answer for a door. It is in the window so that it runs, and out of sight. -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:importantForAccessibility="noHideDescendants" />

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                style="@style/Widget.App.IconButton"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back" />

        </LinearLayout>

        <!-- The NFT, and under it what is known about it. Let go between the two and the page
             goes to one of them. What there is to do stays at the foot, whichever is in view. -->
        <cash.nonfungible.app.Snapping
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/focus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- The picture, and over it the tick that says a door has been shown it. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="12dp"
                        android:layout_weight="1">

                        <cash.nonfungible.app.Tiles
                            android:id="@+id/tiles"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <cash.nonfungible.app.Tick
                            android:id="@+id/tick"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_tick"
                            android:padding="14dp"
                            android:visibility="gone" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/headline"
                        style="@style/Text.App.Display.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="30sp"
                        tools:text="General admission · 11 of 26" />

                    <TextView
                        android:id="@+id/subline"
                        style="@style/Text.App"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_600"
                        android:maxLines="2"
                        android:textSize="16sp"
                        tools:text="bitcoin++ Seoul · privacy edition" />

                </LinearLayout>

                <include
                    android:id="@+id/about"
                    layout="@layout/part_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>

        </cash.nonfungible.app.Snapping>

        <!-- While this page is up, the phone can be held to a door. -->
        <FrameLayout
            android:id="@+id/hold"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp">

            <cash.nonfungible.app.Dots
                android:id="@+id/dots"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/status"
                style="@style/Text.App.Display"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="12dp"
                android:text="@string/nft_hold" />

        </FrameLayout>

        <!-- Somebody holding a group's tickets shows them together, or just this one. -->
        <TextView
            android:id="@+id/group"
            style="@style/Widget.App.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Showing just this one · Show all 4"
            tools:visibility="visible" />

        <!-- Somebody else's NFT: who has it for sale and for what. -->
        <TextView
            android:id="@+id/seller"
            style="@style/Text.App.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:text="Listed by the organiser" />

        <!-- What is known about the NFT is under its picture; the rest is the owner's to do. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/details"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result_details" />

            <TextView
                android:id="@+id/sell"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/nft_sell" />

            <TextView
                android:id="@+id/send"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/nft_send" />

        </LinearLayout>

        <!-- The one main thing: for the owner, a door's code; for anybody else, buying it. -->
        <TextView
            android:id="@+id/scan"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nft_scan" />

        <TextView
            android:id="@+id/buy"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:text="Buy for 21 sats" />

    </LinearLayout>

</FrameLayout>

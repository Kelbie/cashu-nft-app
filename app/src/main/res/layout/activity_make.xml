<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The pages that draw and mint. They are in the window so that they run, and out of sight. -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:importantForAccessibility="noHideDescendants" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                style="@style/Widget.App.IconButton"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                style="@style/Text.App.Display.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="@string/make_title" />

        </LinearLayout>

        <!-- What to make: a name, a look, and how many of each kind. -->
        <cash.nonfungible.app.Halftone
            android:id="@+id/form"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/name"
                        style="@style/Widget.App.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/make_name"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"
                        android:maxLength="40" />

                    <HorizontalScrollView
                        android:id="@+id/looks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/templates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp" />

                    </HorizontalScrollView>

                    <!-- One picture for each type, side by side: the one being changed is brought into view. -->
                    <HorizontalScrollView
                        android:id="@+id/previews_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/previews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/kinds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/add_kind"
                        style="@style/Widget.App.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/make_add_kind" />

                    <!-- One NFT can be somebody's own: their name on it, and their face. -->
                    <LinearLayout
                        android:id="@+id/whose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/guest"
                            style="@style/Widget.App.Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/make_guest"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="40" />

                        <TextView
                            android:id="@+id/photo"
                            style="@style/Widget.App.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:text="@string/make_photo" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </cash.nonfungible.app.Halftone>

        <!-- What is being made: every NFT has its place from the start, and takes it as it is minted. -->
        <cash.nonfungible.app.Mosaic
            android:id="@+id/made"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="14dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            style="@style/Text.App.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="2"
            tools:text="Drawing 3 of 12…" />

        <TextView
            android:id="@+id/make"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Make 12 NFTs" />

    </LinearLayout>

    <cash.nonfungible.app.Confetti
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

</FrameLayout>

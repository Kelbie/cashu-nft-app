<?xml version="1.0" encoding="utf-8"?>

<!-- A change of prices: the day it comes, and what each kind costs from then. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/day"
            style="@style/Widget.App.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:minHeight="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            tools:text="From Sat, 1 Nov" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/apply"
            style="@style/Widget.App.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prices_apply" />

        <TextView
            android:id="@+id/remove"
            style="@style/Widget.App.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/prices_remove"
            android:text="×"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

</LinearLayout>

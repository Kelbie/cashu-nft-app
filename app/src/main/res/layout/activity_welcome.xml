<?xml version="1.0" encoding="utf-8"?>

<!-- The first thing the app asks, and the only one: what to call whoever is holding it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/Widget.App.IconButton"
            android:contentDescription="@string/common_back"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp">

                <LinearLayout
                    android:id="@+id/brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brand" />

                    <TextView
                        style="@style/Text.App.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/app_name"
                        android:textSize="21sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/title"
                    style="@style/Text.App.Display.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/welcome_title"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/help"
                    style="@style/Text.App.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/welcome_help"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/name"
                    style="@style/Widget.App.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:autofillHints="name"
                    android:hint="@string/welcome_name"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:minHeight="56dp"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Text.App.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/welcome_name_help" />

                <!-- A phone that was used before it had accounts: what it kept is this account's. -->
                <TextView
                    android:id="@+id/kept"
                    style="@style/Text.App.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/welcome_kept"
                    android:textColor="@color/ink"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

        <!-- The page that reads a key somebody kept. In the window so that it runs, and out of sight. -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="2dp"
            android:layout_height="2dp"
            android:importantForAccessibility="noHideDescendants" />

        <TextView
            android:id="@+id/go"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_go" />

        <!-- For somebody who kept the key of an account they had before. -->
        <TextView
            android:id="@+id/restore"
            style="@style/Widget.App.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/welcome_restore" />

    </LinearLayout>

</FrameLayout>

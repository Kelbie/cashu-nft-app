<?xml version="1.0" encoding="utf-8"?>

<!-- One sheet for everything a guest is told or asked: a heading, a sentence, something to look
     at, and at most two things to do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_grabber" />

    <TextView
        android:id="@+id/title"
        style="@style/Text.App.Display.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="main entrance" />

    <TextView
        android:id="@+id/text"
        style="@style/Text.App.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        tools:text="asks to see your ticket for Small Press Night. Showing it does not give it away." />

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <cash.nonfungible.app.Mosaic
            android:id="@+id/mosaic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <cash.nonfungible.app.Tick
            android:id="@+id/tick"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tick"
            android:padding="12dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:contentDescription="@string/guest_code"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </FrameLayout>

    <EditText
        android:id="@+id/amount"
        style="@style/Widget.App.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="9"
        android:visibility="gone" />

    <!-- Something long that is pasted, not typed: an invoice. -->
    <EditText
        android:id="@+id/words"
        style="@style/Widget.App.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/jetbrains_mono_400"
        android:hint="@string/wallet_invoice_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="4"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/note"
        style="@style/Text.App.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Paid. Waiting for the seller to hand it over…"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/second"
            style="@style/Widget.App.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/first"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/guest_close" />

    </LinearLayout>

</LinearLayout>

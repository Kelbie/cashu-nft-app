<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A guest reads a door's code with the camera. A phone without one can still host. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- A guest holds their phone to the door's. A phone without NFC shows and scans codes instead. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!-- Where the app opens. A link to a sale or to an NFT somebody gave opens here too. -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="nonfungible.cash"
                    android:pathPrefix="/market/"
                    android:scheme="https" />
                <data
                    android:host="nonfungible.cash"
                    android:pathPrefix="/claim/"
                    android:scheme="https" />
            </intent-filter>
            <!-- A phone held to a door while the app is closed opens here, with what the door asks. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Turning the phone must not replace the code a holder is about to scan. -->
        <activity
            android:name=".DoorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- Turning the phone must not put away a result, or a sale a guest is paying for from it. -->
        <activity
            android:name=".ResultActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".WelcomeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".DeleteActivity" />

        <activity android:name=".ScanActivity" />

        <activity android:name=".PricesActivity" android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EventActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- One of a guest's NFTs. While it is up the phone can be held to a door. -->
        <activity
            android:name=".NftActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- The door, as something a phone can be held to: it answers only while a door is on screen. -->
        <service
            android:name=".tap.TagService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/door_tag" />
        </service>

        <activity android:name=".TicketsActivity" />

        <!-- A collection's page can be shared to the app, or opened with it. -->
        <activity
            android:name=".CollectionActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="nonfungible.cash"
                    android:pathPrefix="/p/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MakeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
